# IDE
.vscode/
.devcontainer/

# OpenWrt build outputs and caches (regenerated by make)
/linkit/bin/
/linkit/build_dir/
/linkit/staging_dir/
/linkit/tmp/
/linkit/dl/
/linkit/logs/
*.log

# Feed clones (after git clone: ./scripts/feeds update -a && ./scripts/feeds install -a)
/linkit/feeds/
/linkit/package/feeds/

# Config backup; linkit/.config is tracked (board + packages)
/linkit/.config.old

# Image signing keys created by make — never commit
/linkit/*.pem
/linkit/key-build*

# Copied from upstream OpenWrt; not required to build
/linkit/.github/
/linkit/.vscode/
/linkit/.devcontainer/
